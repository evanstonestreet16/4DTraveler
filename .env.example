# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Grok (xAI) API key used by the Vite dev-server proxy in
# `vite.plugins/grok-proxy.ts` to call `https://api.x.ai/v1/chat/completions`
# on behalf of the browser. Never expose this to the client.
#
# Get a key at https://console.x.ai/ and rotate it if it is ever pasted in a
# chat, screenshot, or public repo.
GROK_API_KEY=

# Optional. Which Grok model to use. Falls back to `grok-4-latest`.
# GROK_MODEL=grok-4-latest
