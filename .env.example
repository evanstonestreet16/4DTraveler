# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Grok (xAI) --------------------------------------------------------------
# Used by the Vite dev-server proxy at /api/generate-history to call
# `https://api.x.ai/v1/chat/completions` on behalf of the browser. Never
# exposed to the client bundle.
GROK_API_KEY=
# Optional. Which Grok model to use. Falls back to `grok-4-latest`.
# GROK_MODEL=grok-4-latest

# --- Tripo (text-to-3D) ------------------------------------------------------
# Used by the Vite dev-server proxy at /api/tripo/generate + /api/tripo/task/:id
# to upgrade iconic landmark primitives to actual 3D meshes. Optional — if
# the key is missing, iconic objects just keep showing their primitive
# silhouette. Get a key at https://platform.tripo3d.ai/
TRIPO_API_KEY=
# Optional. Which Tripo text-to-model version to use. Defaults to
# `v3.1-20260211` (H3.1 flagship, PBR textures, up to 2M faces).
# Alternative: `P1-20260311` (low-poly Smart Mesh, ~57 s, boxy).
# TRIPO_MODEL=v3.1-20260211
#
# Optional. Geometry quality for v3.x models. `standard` or `detailed`.
# `detailed` = Ultra mode (higher face count, +20 credits, slower).
# Defaults to `detailed`. Ignored for P-series.
# TRIPO_GEOMETRY_QUALITY=detailed
#
# Optional. Texture quality for v3.x models. `standard`, `detailed`,
# or `extreme`. `detailed` = HD textures (+10 credits). `extreme` = 8K.
# Defaults to `standard`. Ignored for P-series.
# TRIPO_TEXTURE_QUALITY=standard
