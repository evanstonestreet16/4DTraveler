{
  "name": "4d-traveler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:fixture": "node scripts/generate-model-fixture.mjs",
    "assets:validate": "vitest run src/components/world/modelAsset.test.ts src/components/world/heroModel.test.ts",
    "assets:hero": "node scripts/generate-pittsburgh-model.js",
    "profile:world": "node scripts/profile-world.mjs",
    "assets:budget": "node scripts/asset-budgets.mjs",
    "geo:build": "node scripts/build-geo.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@turf/simplify": "^7.4.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
